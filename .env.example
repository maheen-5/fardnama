# FardNama environment configuration
# Copy this file to .env for local development.

APP_ENV=development
LOG_LEVEL=info
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
FARDNAMA_MAX_UPLOAD_BYTES=10485760
FARDNAMA_UPLOAD_DIR=/app/data/evidence

POSTGRES_USER=fardnama
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fardnama
DATABASE_URL=postgresql+psycopg://fardnama:change-me@postgres:5432/fardnama

REDIS_URL=redis://redis:6379/0
IPFS_API_URL=http://ipfs:5001

ETH_RPC_URL=http://ethereum:8545
CHAIN_ID=31337
EVIDENCE_REGISTRY_ADDRESS=
# Fill this after the contract is deployed in Final-1.
REGISTRAR_KEY_FILE=/run/secrets/registrar_key
KEK_FILE=/run/secrets/fardnama_kek

TESSERACT_CMD=/usr/bin/tesseract
BACKEND_TAG=latest
